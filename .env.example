# MAETHIST production settings, for Render's "Add from .env" (or any host).
# Copy this file to render.env (ignored by git; not .env, which the local
# dev server would load and switch to production), fill in SECRET_KEY, and
# never commit it:
# this repository is public.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

PYTHON_VERSION=3.12.7
INKYSCIB_ENV=production
TRUST_PROXY_HEADERS=true
FORCE_HTTPS=true
YOUTUBE_FULL_FRAMES=true
YOUTUBE_FRAME_MAX_HEIGHT=1080
YOUTUBE_FRAME_CONCURRENCY=2
OFFLINE_SHELL=on

# Optional. Add once you know them (see render.yaml for what each does).
# SITE_ORIGIN must be the exact public address, no trailing slash: every
# visit is redirected to it, so leave it out until the first deploy works.
# SITE_ORIGIN=https://your-app.onrender.com
# PRIVACY_CONTACT_EMAIL=privacy@example.com
# STATS_TOKEN=
# SEARCH_CONSOLE_TOKEN=
#
# Do not set WEB_CONCURRENCY: it must stay 1 (live boards live in memory).
