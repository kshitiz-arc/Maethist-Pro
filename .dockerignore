# Only what the app needs to run goes into the image.
.git
.github
.gstack
.claude
.vscode
.idea
**/__pycache__
**/*.py[cod]
*.log

# Secrets and local settings: never in an image.
.env
.env.*
!.env.example
render.env
credentials.json
*.pem
*.key

# Not needed to run it.
tests
docs
tools
graphify-out
output
tmp
data
_qa_*
.backup-*
*.png
!static/**/*.png
node_modules
requirements-ocr.txt
